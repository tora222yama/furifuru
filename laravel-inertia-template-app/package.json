{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "tsc": "tsc --noEmit",
        "prettier": "./node_modules/.bin/prettier --write 'resources/js/**/*.{ts,tsx}'",
        "eslint": "./node_modules/.bin/eslint --fix 'resources/js/**/*.{ts,tsx}'",
        "prepare": "cd .. && husky ./laravel-inertia-template-app/.husky",
        "pint": "./vendor/bin/pint",
        "lint-staged": "lint-staged",
        "lefthook": "lefthook run pre-commit"
    },
    "devDependencies": {
        "@emotion/react": "^11.11.4",
        "@emotion/styled": "^11.11.0",
        "@inertiajs/react": "^1.0.15",
        "@mui/material": "^5.15.13",
        "@types/react": "^18.2.64",
        "@types/react-dom": "^18.2.21",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "axios": "^1.6.4",
        "eslint": "^8.57.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "^9.0.11",
        "laravel-vite-plugin": "^1.0.0",
        "lefthook": "^1.6.7",
        "lint-staged": "^15.2.2",
        "prettier": "^3.2.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.4.2",
        "vite": "^5.0.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.php": [
            "pint"
        ]
    }
}
