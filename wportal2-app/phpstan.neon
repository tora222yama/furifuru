includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - database/

    # Level 10 is the highest level
    level: 1

    ignoreErrors:
            # 問題ないマジックメソッドの除外.
            - '#Access to an undefined property App\\Models\\(.*)#'
